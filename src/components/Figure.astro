---
// One figure: an image (click to zoom), a looping video, or a dashed placeholder. The caption is the slot.
// Images come from src/assets/img and are resized by Astro; videos are served from public/img.
import { getImage, Image } from 'astro:assets';
import { image } from '../lib/images';
import { withBase } from '../lib/url';

interface Props {
	src?: string;
	alt?: string;
	/** Crop to fill the frame instead of fitting inside it. */
	photo?: boolean;
	/** Certificates use a 4:3 frame. */
	cert?: boolean;
	video?: string;
	poster?: string;
	label?: string;
	placeholder?: string;
}

const { src, alt, photo, cert, video, poster, label, placeholder } = Astro.props;
const frame = 'block w-full rounded-lg border border-line bg-white';
const img = src ? image(src) : undefined;
// The lightbox shows the full-size image rather than the thumbnail-sized one in the figure.
const full = img && (await getImage({ src: img })).src;
const posterSrc = poster && (await getImage({ src: image(poster) })).src;
---

<figure>
	{
		video ? (
			<video
				src={withBase(video)}
				poster={posterSrc}
				muted
				loop
				playsinline
				autoplay
				preload="metadata"
				aria-label={label}
				class:list={[frame, 'aspect-[16/10] object-contain']}
			/>
		) : placeholder ? (
			<div class="grid aspect-[16/10] place-items-center rounded-lg border-[1.5px] border-dashed border-line bg-ph p-3.5 text-center font-sans text-[12.5px]/[1.45] text-muted">
				<span class="mb-1 block font-semibold text-ink opacity-70">＋ Figure to add</span>
				{placeholder}
			</div>
		) : (
			img && (
			<Image
				src={img}
				alt={alt ?? ''}
				widths={[480, 960]}
				sizes="(min-width: 901px) 560px, 100vw"
				loading="lazy"
				data-full={full}
				class:list={[
					frame,
					'cursor-zoom-in',
					cert ? 'aspect-[4/3]' : 'aspect-[16/10]',
					photo ? 'object-cover' : 'object-contain',
				]}
			/>
			)
		)
	}
	<figcaption class="mt-[7px] font-sans text-[13px]/[1.45] text-muted [&_b]:font-semibold [&_b]:text-ink">
		<slot />
	</figcaption>
</figure>
